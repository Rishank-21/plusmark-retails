# Canonical site URL (used for metadata, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.plusmarkboards.com

# Cloudinary video delivery and signed uploads (API secret is server-only)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin panel (/admin) — both required. Use a strong password; secret must be 32+ random characters
# (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Enquiry database — Firebase Realtime Database (server-side, Admin SDK). SECRET — never commit.
# Firebase console → Project settings → Service accounts → "Generate new private key".
# Either paste the whole JSON on one line:
FIREBASE_SERVICE_ACCOUNT=
# …or use the two fields from it (keep the \n sequences in the key, wrap in double quotes):
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional, defaults to the project's RTDB URL
FIREBASE_DATABASE_URL=

# Firebase web config (public; defaults are built in — override only for another project)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ==============================================================================
# ENQUIRY NOTIFICATIONS (SMS, WhatsApp, Email, Webhook)
# ==============================================================================

# 1. SMS Notifications to Admin (Text Message)
# Option A: Fast2SMS (Simple India SMS API)
FAST2SMS_API_KEY=
# Option B: Twilio SMS (Global)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Admin Phone for receiving SMS (Defaults to +919913967888 if blank)
ADMIN_SMS_PHONE=+919913967888
# Option C: Generic HTTP SMS Gateway (placeholders: {phone} and {message})
SMS_GATEWAY_URL=

# 2. WhatsApp Notifications to Admin
# Option A: Twilio WhatsApp
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Option B: Meta WhatsApp Cloud API
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Option C: CallMeBot WhatsApp (Personal free bot)
CALLMEBOT_PHONE=
CALLMEBOT_API_KEY=
# Admin WhatsApp number (Defaults to +919913967888 if blank)
ADMIN_WHATSAPP_NUMBER=+919913967888

# 3. Webhook (Zapier / Make / Pabbly / Slack / CRM)
ENQUIRY_WEBHOOK_URL=

# 4. Email Notifications (Resend)
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=

# Contact channel overrides — WhatsApp/phone default to the owner's number (+91 99139 67888); email only shown when set
NEXT_PUBLIC_WHATSAPP_NUMBER=+919913967888
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=+919913967888
