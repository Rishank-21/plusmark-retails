# Canonical site URL (used for metadata, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.plusmarkboards.com

# Cloudinary video delivery and signed uploads (API secret is server-only)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin panel (/admin) — both required. Use a strong password; secret must be 32+ random characters
# (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Enquiry database — Firebase Realtime Database (server-side, Admin SDK). SECRET — never commit.
# Firebase console → Project settings → Service accounts → "Generate new private key".
# Either paste the whole JSON on one line:
FIREBASE_SERVICE_ACCOUNT=
# …or use the two fields from it (keep the \n sequences in the key, wrap in double quotes):
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional, defaults to the project's RTDB URL
FIREBASE_DATABASE_URL=

# Firebase web config (public; defaults are built in — override only for another project)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Optional enquiry notifications (enquiries are always stored in the database)
ENQUIRY_WEBHOOK_URL=
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=

# Contact channel overrides — WhatsApp/phone default to the owner's number (+91 99139 67888); email only shown when set
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
